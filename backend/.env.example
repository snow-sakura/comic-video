# ===== AI 漫剧工坊 - 后端环境变量 =====
# 复制为 .env 并填入真实值

# 数据库 / 队列
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/comic_video
REDIS_URL=redis://localhost:6379

# 存储根目录（相对路径基于 backend/ 运行目录）
STORAGE_DIR=./storage

# Mock 模式：auto=有Key用真、无Key自动mock | true=强制mock | false=强制真实
MOCK_MODE=auto

# ===== Agnes AI 全家桶（默认供应商，统一 Base URL）=====
# 控制台获取 Key：https://platform.agnes-ai.com
# 文本 / 图像 / 视频 默认统一走 Agnes 最新版（免费档：agnes-3.0-flash / agnes-image-2.5-flash / agnes-video-2.5-flash）
TEXT_PROVIDER=agnes
TEXT_API_KEY=
TEXT_MODEL=agnes-3.0-flash
TEXT_BASE_URL=https://apihub.agnes-ai.com/v1

IMAGE_PROVIDER=agnes
IMAGE_API_KEY=
IMAGE_MODEL=agnes-image-2.5-flash
IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1

VIDEO_PROVIDER=agnes
VIDEO_API_KEY=
VIDEO_MODEL=agnes-video-2.5-flash
VIDEO_BASE_URL=https://apihub.agnes-ai.com/v1

# ===== TTS（留空 = Mock）=====
# edge-tts=微软免费(无需Key) | mimo=小米MiMo-TTS(官方免费额度,OpenAI兼容/audio/speech,默认) |
# tokendance=TokenDance音频网关(按量计费) | confucius4=本地 | voxcpm=本地开源(免费)
TTS_ENGINE=mimo
TTS_API_KEY=
TTS_MODEL=mimo-v2.5-tts
TTS_VOICE=
# 默认走小米官方直连（免费额度）；如需经 TokenDance 网关请改指向 https://tokendance.space/gateway/v1
TTS_BASE_URL=https://api.xiaomimimo.com/v1

# ===== 前端同源部署 / CORS =====
# 前端开发环境 Vite 走代理，生产环境需配置实际前端域名
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 生成调度与并发（2026-10-16 档位化队列）=====
# 强制调度档位：free=单任务串行(solo worker) | paid=多进程并行(prefork) | 留空=按模型 catalog 标签自动判定
SCHED_TIER=
# 付费档各能力并行度（覆盖默认 script=2/image=4/video=3/audio=4/compose=1）
# WORKER_CONCURRENCY_SCRIPT=2
# WORKER_CONCURRENCY_IMAGE=4
# WORKER_CONCURRENCY_VIDEO=3
# WORKER_CONCURRENCY_AUDIO=4
# WORKER_CONCURRENCY_COMPOSE=1
# 自动连播：上一阶段完成自动入队下一阶段（视频→配音→合成→下一集）；设置页 sched.autoAdvance 优先
SCHED_AUTO_ADVANCE=true
# LLM 请求超时（秒），默认 600
TEXT_TIMEOUT_SEC=600
